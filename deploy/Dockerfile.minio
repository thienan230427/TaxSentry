FROM golang:1.24.8-bookworm AS build

# Last community security release; MinIO stopped publishing patched community images.
COPY deploy/minio-entrypoint.go /tmp/minio-entrypoint.go
RUN CGO_ENABLED=0 go install -trimpath \
    github.com/minio/minio@9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
        -o /go/bin/minio-entrypoint /tmp/minio-entrypoint.go \
    && mkdir /out-data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /go/bin/minio /usr/local/bin/minio
COPY --from=build /go/bin/minio-entrypoint /usr/local/bin/minio-entrypoint
COPY --from=build --chown=65532:65532 /out-data /data
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio-entrypoint"]
CMD ["server", "/data", "--console-address", ":9001"]
