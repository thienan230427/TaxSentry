{
  "name": "taxsentry-v3-production",
  "services": {
    "postgres": {
      "image": "pgvector/pgvector:0.8.2-pg16-bookworm",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "${POSTGRES_DB:-taxsentry}",
        "POSTGRES_USER": "${POSTGRES_USER:-taxsentry}",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres_password",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --data-checksums"
      },
      "command": [
        "postgres",
        "-c",
        "ssl=on",
        "-c",
        "ssl_min_protocol_version=TLSv1.2",
        "-c",
        "ssl_cert_file=/run/secrets/postgres_tls_cert",
        "-c",
        "ssl_key_file=/run/secrets/postgres_tls_key",
        "-c",
        "ssl_ca_file=/run/secrets/postgres_ca",
        "-c",
        "hba_file=/etc/postgresql/pg_hba.conf",
        "-c",
        "password_encryption=scram-sha-256",
        "-c",
        "log_statement=none"
      ],
      "expose": [
        "5432"
      ],
      "volumes": [
        "postgres-data:/var/lib/postgresql/data",
        "./postgres/pg_hba.conf:/etc/postgresql/pg_hba.conf:ro"
      ],
      "secrets": [
        {
          "source": "postgres_password",
          "target": "postgres_password",
          "uid": "999",
          "gid": "999",
          "mode": 256
        },
        {
          "source": "postgres_ca",
          "target": "postgres_ca",
          "uid": "999",
          "gid": "999",
          "mode": 292
        },
        {
          "source": "postgres_tls_cert",
          "target": "postgres_tls_cert",
          "uid": "999",
          "gid": "999",
          "mode": 292
        },
        {
          "source": "postgres_tls_key",
          "target": "postgres_tls_key",
          "uid": "999",
          "gid": "999",
          "mode": 256
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 20
      },
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=256m",
        "/var/run/postgresql:rw,nosuid,nodev,size=32m"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "CHOWN",
        "DAC_OVERRIDE",
        "FOWNER",
        "SETGID",
        "SETUID"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cpus": "2.0",
      "mem_limit": "4g",
      "pids_limit": 256,
      "networks": [
        "backend"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "minio": {
      "build": {
        "context": "..",
        "dockerfile": "deploy/Dockerfile.minio"
      },
      "restart": "unless-stopped",
      "environment": {
        "MINIO_ROOT_USER_FILE": "/run/secrets/minio_root_user",
        "MINIO_ROOT_PASSWORD_FILE": "/run/secrets/minio_root_password"
      },
      "command": [
        "server",
        "--certs-dir",
        "/run/secrets/minio-certs",
        "--console-address",
        ":9001",
        "/data"
      ],
      "expose": [
        "9000",
        "9001"
      ],
      "volumes": [
        "minio-data:/data"
      ],
      "secrets": [
        {
          "source": "minio_root_user",
          "target": "minio_root_user",
          "uid": "65532",
          "gid": "65532",
          "mode": 256
        },
        {
          "source": "minio_root_password",
          "target": "minio_root_password",
          "uid": "65532",
          "gid": "65532",
          "mode": 256
        },
        {
          "source": "minio_ca",
          "target": "/run/secrets/minio-certs/CAs/root.crt",
          "uid": "65532",
          "gid": "65532",
          "mode": 292
        },
        {
          "source": "minio_tls_cert",
          "target": "/run/secrets/minio-certs/public.crt",
          "uid": "65532",
          "gid": "65532",
          "mode": 292
        },
        {
          "source": "minio_tls_key",
          "target": "/run/secrets/minio-certs/private.key",
          "uid": "65532",
          "gid": "65532",
          "mode": 256
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "/usr/local/bin/minio-entrypoint",
          "healthcheck"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 20
      },
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=256m"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cpus": "2.0",
      "mem_limit": "4g",
      "pids_limit": 256,
      "networks": [
        "backend"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "worker": {
      "build": {
        "context": "..",
        "dockerfile": "deploy/Dockerfile.worker"
      },
      "restart": "unless-stopped",
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "TAXSENTRY_POSTGRES_DSN_FILE": "/run/secrets/postgres_dsn",
        "TAXSENTRY_JOB_HANDLER": "${TAXSENTRY_JOB_HANDLER:-taxsentry.data_plane.document_worker:handle_document_job}",
        "TAXSENTRY_LEASE_SECONDS": "${TAXSENTRY_LEASE_SECONDS:-60}",
        "TAXSENTRY_POLL_SECONDS": "${TAXSENTRY_POLL_SECONDS:-2}",
        "TAXSENTRY_S3_ENDPOINT": "https://minio:9000",
        "TAXSENTRY_S3_BUCKET": "${TAXSENTRY_S3_BUCKET:-taxsentry}",
        "TAXSENTRY_S3_ACCESS_KEY_FILE": "/run/secrets/worker_s3_access_key",
        "TAXSENTRY_S3_SECRET_KEY_FILE": "/run/secrets/worker_s3_secret_key",
        "TAXSENTRY_S3_ALLOW_INSECURE": "false",
        "AWS_CA_BUNDLE": "/run/secrets/minio_ca",
        "PYTHONDONTWRITEBYTECODE": "1",
        "TMPDIR": "/tmp"
      },
      "secrets": [
        {
          "source": "postgres_dsn",
          "target": "postgres_dsn",
          "uid": "10001",
          "gid": "10001",
          "mode": 256
        },
        {
          "source": "postgres_ca",
          "target": "postgres_ca",
          "uid": "10001",
          "gid": "10001",
          "mode": 292
        },
        {
          "source": "minio_ca",
          "target": "minio_ca",
          "uid": "10001",
          "gid": "10001",
          "mode": 292
        },
        {
          "source": "worker_s3_access_key",
          "target": "worker_s3_access_key",
          "uid": "10001",
          "gid": "10001",
          "mode": 256
        },
        {
          "source": "worker_s3_secret_key",
          "target": "worker_s3_secret_key",
          "uid": "10001",
          "gid": "10001",
          "mode": 256
        }
      ],
      "user": "10001:10001",
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=1g",
        "/work:rw,noexec,nosuid,nodev,size=4g"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cpus": "${TAXSENTRY_WORKER_CPUS:-2.0}",
      "mem_limit": "${TAXSENTRY_WORKER_MEMORY:-4g}",
      "pids_limit": 512,
      "networks": [
        "backend"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "networks": {
    "backend": {
      "driver": "bridge",
      "internal": true
    }
  },
  "volumes": {
    "postgres-data": {},
    "minio-data": {}
  },
  "secrets": {
    "postgres_password": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/postgres_password"
    },
    "postgres_dsn": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/postgres_dsn"
    },
    "postgres_ca": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/postgres_ca.crt"
    },
    "postgres_tls_cert": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/postgres.crt"
    },
    "postgres_tls_key": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/postgres.key"
    },
    "minio_root_user": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/minio_root_user"
    },
    "minio_root_password": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/minio_root_password"
    },
    "minio_ca": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/minio_ca.crt"
    },
    "minio_tls_cert": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/minio.crt"
    },
    "minio_tls_key": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/minio.key"
    },
    "worker_s3_access_key": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/worker_s3_access_key"
    },
    "worker_s3_secret_key": {
      "file": "${TAXSENTRY_SECRET_DIR:?Set TAXSENTRY_SECRET_DIR}/worker_s3_secret_key"
    }
  }
}
