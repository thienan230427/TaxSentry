# Local coordinator defaults. Use TLS endpoints, Docker secrets, encrypted host
# volumes, and a firewall before binding services to a LAN address.
TAXSENTRY_BIND_HOST=127.0.0.1

POSTGRES_DB=taxsentry
POSTGRES_USER=taxsentry
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret-key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
TAXSENTRY_S3_BUCKET=taxsentry

# Override only when adding another governed job type.
TAXSENTRY_JOB_HANDLER=taxsentry.data_plane.document_worker:handle_document_job
TAXSENTRY_LEASE_SECONDS=60
TAXSENTRY_POLL_SECONDS=2
TAXSENTRY_WORKER_CPUS=2
TAXSENTRY_WORKER_MEMORY=4G
